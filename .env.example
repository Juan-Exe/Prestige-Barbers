# ==================== CONFIGURACIÓN GENERAL ====================
NODE_ENV=development
PORT=3000

# ==================== JWT - AUTENTICACIÓN ====================
# CRÍTICO: Generar una clave segura en producción
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# ==================== BASE DE DATOS MARIADB ====================
DB_HOST=mariadb
DB_PORT=3306
DB_USER=prestige_user
DB_PASSWORD=prestige_password123
DB_NAME=barberia
DB_ROOT_PASSWORD=rootpassword123

# ==================== CORS - ORÍGENES PERMITIDOS ====================
# Desarrollo: múltiples orígenes locales
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.36:3000

# Producción: solo dominios autorizados
# ALLOWED_ORIGINS=https://prestigebarbers.com,https://www.prestigebarbers.com

# ==================== RATE LIMITING ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ==================== ARCHIVOS ====================
MAX_FILE_SIZE=5242880

# ==================== LOGGING ====================
LOG_LEVEL=info

# ==================== DOCKER PORTS ====================
APP_PORT=3000
DB_PORT_EXPOSE=3306
ADMINER_PORT=8080

# ==================== FACTUS PAY (pasarela QR Bre-B) ====================
# Credenciales propias, distintas de las de Facturacion.
FACTUS_PAY_BASE_URL=https://pay-api-sandbox.factus.com.co
FACTUS_PAY_EMAIL=cambiar@ejemplo.co
FACTUS_PAY_PASSWORD=cambiar
# Llave del webhook: 32+ caracteres, distinta en cada entorno.
FACTUS_PAY_WEBHOOK_KEY=cambiar-por-una-llave-larga-y-aleatoria
# Vigencia del QR en segundos (por defecto 1800 = 30 min)
FACTUS_QR_EXPIRATION_SECONDS=1800
FACTUS_PAY_TIMEOUT_MS=10000
