# ==================== CONFIGURACIÓN GENERAL ====================
NODE_ENV=development
PORT=3000

# ==================== JWT - AUTENTICACIÓN ====================
# CRÍTICO: Generar una clave segura en producción
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# ==================== BASE DE DATOS MARIADB ====================
DB_HOST=mariadb
DB_PORT=3306
DB_USER=prestige_user
DB_PASSWORD=prestige_password123
DB_NAME=barberia
DB_ROOT_PASSWORD=rootpassword123

# ==================== CORS - ORÍGENES PERMITIDOS ====================
# Desarrollo: múltiples orígenes locales
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.36:3000

# Producción: solo dominios autorizados
# ALLOWED_ORIGINS=https://prestigebarbers.com,https://www.prestigebarbers.com

# ==================== RATE LIMITING ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ==================== ARCHIVOS ====================
MAX_FILE_SIZE=5242880

# ==================== LOGGING ====================
LOG_LEVEL=info

# ==================== DOCKER PORTS ====================
APP_PORT=3000
DB_PORT_EXPOSE=3306
ADMINER_PORT=8080

# ==================== FACTUS PAY (pasarela QR Bre-B) ====================
# Credenciales propias, distintas de las de Facturacion.
FACTUS_PAY_BASE_URL=https://pay-api-sandbox.factus.com.co
FACTUS_PAY_EMAIL=cambiar@ejemplo.co
FACTUS_PAY_PASSWORD=cambiar
# Llave del webhook: 32+ caracteres, distinta en cada entorno.
FACTUS_PAY_WEBHOOK_KEY=cambiar-por-una-llave-larga-y-aleatoria
# Vigencia del QR en segundos (por defecto 1800 = 30 min)
FACTUS_QR_EXPIRATION_SECONDS=1800
FACTUS_PAY_TIMEOUT_MS=10000

# ============ FACTUS FACTURACION (factura electronica DIAN) ============
# API distinta de Factus Pay, con credenciales propias.
FACTUS_API_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=cambiar
FACTUS_CLIENT_SECRET=cambiar
FACTUS_USERNAME=cambiar@ejemplo.co
FACTUS_PASSWORD=cambiar
# Se consulta solo si no se fija: GET /v2/numbering-ranges
FACTUS_NUMBERING_RANGE_ID=
# Codigo DIAN del municipio, opcional
FACTUS_DEFAULT_MUNICIPALITY_CODE=

# ==================== CORREO (envio de facturas) ====================
# Factus solo envia a su lista blanca en sandbox, asi que el correo lo
# manda el backend con el PDF y el XML adjuntos.
#
# Para Gmail hace falta una contrasena de aplicacion, no la del correo:
#   myaccount.google.com -> Seguridad -> Verificacion en 2 pasos
#   -> Contrasenas de aplicaciones
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=la-contrasena-de-aplicacion-de-16-letras
SMTP_FROM_NAME=Prestige Barbers
